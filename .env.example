# ---------------------------------------------------------------------------
# LinkedIn Sidekick - ADK  |  Environment template
# Copy to `.env` and fill in real credentials.
# ---------------------------------------------------------------------------

# --- Generative AI & Google ADK Credentials --------------------------------
GOOGLE_API_KEY="AIzaSy..."
# GEMINI_API_KEY="AIzaSy..."          # Optional alias for GOOGLE_API_KEY

# --- LinkedIn Developer Credentials ----------------------------------------
# OAuth 2.0 access token carrying the `w_member_social` scope
LINKEDIN_ACCESS_TOKEN="AQV_..."
# LinkedIn member person id (digits only, e.g. 12345678)
LINKEDIN_PERSON_URN="8675309"

# --- Configuration Location ------------------------------------------------
# Which YAML file to load. File-system locations (the Twitter cookie export and
# the ledger database) are configured inside that YAML, never here.
CONFIG_PATH="config.yaml"

# --- Runtime Overrides -----------------------------------------------------
# Fractional/whole seconds waited between monitored accounts (rate limiting)
SIDEKICK_ACCOUNT_DELAY_SECONDS="1.5"
